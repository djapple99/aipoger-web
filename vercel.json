{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/account-notifications",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/monthly-charts",
      "schedule": "5 16 * * *"
    },
    {
      "path": "/api/listen-bar/cleanup-messages",
      "schedule": "0 */8 * * *"
    },
    {
      "path": "/api/battle-pool/process-fallbacks",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/battle-pool/cancel-stale-challenges",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "src/app/api/upload-hook/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/blind-listen/route.ts": {
      "regions": [
        "hnd1"
      ]
    },
    "src/app/api/blind-listen/audio/route.ts": {
      "regions": [
        "hnd1"
      ]
    }
  }
}
